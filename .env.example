# Backend environment variables. Copy to .env and fill in.
# Names only — never commit real values to this file.
# The authoritative list is config.py; keep the two in sync.

# ── Required ──────────────────────────────────────────────
# config.py refuses to start if any of these are missing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=

# ── Strongly recommended ──────────────────────────────────
# Without this, sentry_sdk.init() never runs and EVERY
# capture_exception() call in the codebase is a silent no-op.
# main.py prints a warning at boot when it is unset.
SENTRY_DSN=

# ── URLs ──────────────────────────────────────────────────
# Both have defaults in config.py; set explicitly in production.
FRONTEND_URL=
BACKEND_PUBLIC_URL=

# ── WhatsApp (per-feature; unset = channel unavailable) ────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=

# ── Telegram ──────────────────────────────────────────────
TELEGRAM_WEBHOOK_SECRET=

# ── Shopify ───────────────────────────────────────────────
# SHOPIFY_APP_SCOPES and SHOPIFY_API_VERSION have defaults in
# config.py; override only to change scopes or pin an API version.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URI=
SHOPIFY_APP_SCOPES=
SHOPIFY_API_VERSION=

# ── Razorpay: partner OAuth ───────────────────────────────
# Merchants connect THEIR OWN Razorpay account through this.
# RAZORPAY_PARTNER_MODE is "test" | "live" — flip to "live" and
# swap in the Production client id/secret when going live.
RAZORPAY_PARTNER_CLIENT_ID=
RAZORPAY_PARTNER_CLIENT_SECRET=
RAZORPAY_PARTNER_REDIRECT_URI=
RAZORPAY_PARTNER_MODE=
RAZORPAY_WEBHOOK_SECRET=

# ── Razorpay: billing (Zavo's OWN merchant account) ────────
# Charges Zavo's SaaS customers. Distinct from the partner OAuth
# credentials above — see the comment block in config.py.
RAZORPAY_BILLING_KEY_ID=
RAZORPAY_BILLING_KEY_SECRET=
RAZORPAY_BILLING_WEBHOOK_SECRET=
RAZORPAY_PRO_MONTHLY=
RAZORPAY_PRO_YEARLY=
RAZORPAY_BUSINESS_MONTHLY=
RAZORPAY_BUSINESS_YEARLY=

# ── Optional ──────────────────────────────────────────────
# Lets our own Next.js routes pass the real visitor IP for
# rate-limit keys. Unset falls back to older behaviour.
INTERNAL_PROXY_SECRET=
